  "description": "Medas entity generator",
  "keywords": [
    "entities"
  ],
  "authors": [
    {
      "name": "Patrick Morpey",
      "email": "patrick@morphp.nl"
    }
  ],
  "type": "library",
  "require": {
    "morphp/medas-console": "^3",
    "morphp/medas-core": "^4",
    "morphp/medas-file-system": "^3",
    "php": "^8.4"
  },
  "require-dev": {
    "morphp/medas-config-manager": "^3",
    "morphp/medas-config-options": "^3",
    "morphp/medas-object-instantiator": "^4",
    "morphp/medas-service-manager": "^4",
    "phpunit/phpunit": "^10"
  },
  "autoload": {
    "psr-4": {
      "Medas\\EntityGenerator\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Medas\\EntityGeneratorTest\\": "tests/"
